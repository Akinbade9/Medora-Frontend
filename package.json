{
  "name": "medora-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0 <23 || >=24.3.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @medora/web-dashboard",
    "dev:mobile": "npm run start --workspace @medora/patient-mobile",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace @medora/web-dashboard",
    "build:mobile": "npm run build --workspace @medora/patient-mobile",
    "test": "npm test --workspace @medora/web-dashboard",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run lint && npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.8.0"
  }
}
